import (
	"time"

	"go.mongodb.org/mongo-driver/bson/primitive"

	"../models"
	"../../../../core/entities"
)

// ToEntity converts UserModel to User entity
func ToEntity(model *models.UserModel) *entities.User {
	return &entities.User{
		ID:        model.ID.Hex(),
		Email:     model.Email,
		Name:      model.Name,
		CreatedAt: model.CreatedAt,
		UpdatedAt: model.UpdatedAt,
	}
}

// ToModel converts User entity to UserModel
func ToModel(entity *entities.User) *models.UserModel {
	var id primitive.ObjectID
	if entity.ID != "" {
		if objectID, err := primitive.ObjectIDFromHex(entity.ID); err == nil {
			id = objectID
		}
	}

	return &models.UserModel{
		ID:        id,
		Email:     entity.Email,
		Name:      entity.Name,
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
	}
}
`
}

func generateCleanMongoUserRepository(projectName string) string {
	return fmt.Sprintf(`package repositories

import (
	"context"
	"fmt"

	"go.mongodb.org/mongo-driver/bson"
	"go.mongodb.org/mongo-driver/bson/primitive"
	"go.mongodb.org/mongo-driver/mongo"

	"%s/internal/core/entities"
	"%s/internal/core/interfaces/repositories"
	"../models"
	"../mappers"
)

// UserRepository implements the user repository interface
type UserRepository struct {
	collection *mongo.Collection
}

// NewUserRepository creates a new user repository instance
func NewUserRepository(collection *mongo.Collection) repositories.UserRepository {
	return &UserRepository{
		collection: collection,
	}
}

// Create creates a new user
func (r *UserRepository) Create(ctx context.Context, user *entities.User) (*entities.User, error) {
	model := mappers.ToModel(user)
	
	result, err := r.collection.InsertOne(ctx, model)
	if err != nil {
		return nil, fmt.Errorf("failed to create user: %%w", err)
	}
	
	model.ID = result.InsertedID.(primitive.ObjectID)
	return mappers.ToEntity(model), nil
}

// GetByID retrieves a user by ID
func (r *UserRepository) GetByID(ctx context.Context, id string) (*entities.User, error) {
	objectID, err := primitive.ObjectIDFromHex(id)
	if err != nil {
		return nil, fmt.Errorf("invalid user ID: %%w", err)
	}
	
	var model models.UserModel
	err = r.collection.FindOne(ctx, bson.M{"_id": objectID}).Decode(&model)
	if err != nil {
		if err == mongo.ErrNoDocuments {
			return nil, fmt.Errorf("user not found")
		}
		return nil, fmt.Errorf("failed to get user: %%w", err)
	}
	
	return mappers.ToEntity(&model), nil
}

// Update updates a user
func (r *UserRepository) Update(ctx context.Context, user *entities.User) (*entities.User, error) {
	model := mappers.ToModel(user)
	
	_, err := r.collection.ReplaceOne(ctx, bson.M{"_id": model.ID}, model)
	if err != nil {
		return nil, fmt.Errorf("failed to update user: %%w", err)
	}
	
	return user, nil
}

// Delete deletes a user
func (r *UserRepository) Delete(ctx context.Context, id string) error {
	objectID, err := primitive.ObjectIDFromHex(id)
	if err != nil {
		return fmt.Errorf("invalid user ID: %%w", err)
	}
	
	_, err = r.collection.DeleteOne(ctx, bson.M{"_id": objectID})
	if err != nil {
		return fmt.Errorf("failed to delete user: %%w", err)
	}
	
	return nil
}
`, projectName, projectName)
}

func generateCleanMongoConnection() string {
	return `package mongo

import (
	"context"
	"fmt"

	"go.mongodb.org/mongo-driver/mongo"
