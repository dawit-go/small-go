func generateCleanAPIServer(projectName string) string {
	return fmt.Sprintf(`package app

import (
	"context"
	"fmt"
	"net/http"

	"github.com/go-chi/chi/v5"
	"go.uber.org/fx"
	"go.uber.org/zap"

	"%s/internal/delivery/http/v1/router"
	"%s/internal/shared/config"
)

// Server represents the HTTP server
type Server struct {
	router *chi.Mux
	config *config.Config
	logger *zap.Logger
}

// NewServer creates a new server instance
func NewServer(router *chi.Mux, config *config.Config, logger *zap.Logger) *Server {
	return &Server{
		router: router,
		config: config,
		logger: logger,
	}
}

// StartServer starts the HTTP server
func StartServer(lifecycle fx.Lifecycle, server *Server) {
	lifecycle.Append(fx.Hook{
		OnStart: func(context.Context) error {
			server.logger.Info("Starting server", zap.String("port", server.config.Port))
			go func() {
				if err := http.ListenAndServe(":"+server.config.Port, server.router); err != nil {
					server.logger.Fatal("Failed to start server", zap.Error(err))
				}
			}()
			return nil
		},
		OnStop: func(context.Context) error {
			server.logger.Info("Shutting down server")
			return nil
		},
	})
}
`, projectName, projectName)
}

