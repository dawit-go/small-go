func generateCleanLoggingMiddleware() string {
	return `package middleware

import (
	"net/http"
	"time"

	"go.uber.org/zap"
)

// Logger middleware for request logging
func Logger(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		start := time.Now()
		
		next.ServeHTTP(w, r)
		
		// Log request details
		logger, _ := zap.NewProduction()
		logger.Info("HTTP Request",
			zap.String("method", r.Method),
			zap.String("path", r.URL.Path),
			zap.Duration("duration", time.Since(start)),
		)
	})
}
`
}

func generateCleanErrorHandler() string {
	return `package middleware

import (
	"net/http"
)

// ErrorHandler handles HTTP errors
func ErrorHandler(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if err := recover(); err != nil {
				http.Error(w, "Internal Server Error", http.StatusInternalServerError)
			}
		}()
		next.ServeHTTP(w, r)
	})
}
`
}

func generateCleanSharedConfig() string {
	return `package config

import (
	"os"
)

// Config holds application configuration
type Config struct {
	Port string
	Env  string
}

// NewConfig creates a new config instance
func NewConfig() *Config {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}

	env := os.Getenv("ENV")
	if env == "" {
		env = "development"
	}

	return &Config{
		Port: port,
		Env:  env,
	}
}
`
}

func generateCleanSharedLogger() string {
	return `package logger

import (
	"go.uber.org/zap"
	"go.uber.org/zap/zapcore"
)

// NewLogger creates a new logger instance
func NewLogger() (*zap.Logger, error) {
	config := zap.NewProductionConfig()
	config.EncoderConfig.TimeKey = "timestamp"
	config.EncoderConfig.EncodeTime = zapcore.ISO8601TimeEncoder
	
	return config.Build()
}
`
}

func generateCleanIDUtils() string {
	return `package utils

import (
	"crypto/rand"
	"encoding/hex"
)

// GenerateID generates a random ID
func GenerateID() string {
	bytes := make([]byte, 16)
	rand.Read(bytes)
	return hex.EncodeToString(bytes)
}
`
}

func generateCleanTimeUtils() string {
	return `package utils

import "time"

// Now returns the current time
func Now() time.Time {
	return time.Now()
}

// FormatTime formats time to string
func FormatTime(t time.Time) string {
	return t.Format(time.RFC3339)
}
`
}

